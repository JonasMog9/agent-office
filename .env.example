# Copy to .env for local development. Never commit real values.
# In production these are set in Railway (backend) and Vercel (frontend).

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_office
ANTHROPIC_API_KEY=sk-ant-placeholder
TELEGRAM_BOT_TOKEN=123456:placeholder
TELEGRAM_OWNER_USER_ID=0
TELEGRAM_WEBHOOK_SECRET=change-me
INGEST_SECRET=change-me

# Strava API (create an app at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=00000
STRAVA_CLIENT_SECRET=placeholder
STRAVA_REFRESH_TOKEN=placeholder
STRAVA_ATHLETE_ID=0
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me
STRAVA_BACKFILL_DAYS=365
APPLE_EXPORT_DAYS=400

# Scoring. MAX_HR is estimated from Strava heart-rate data when empty.
ATHLETE_SEX=male
MAX_HR=
SLEEP_NEED_MIN=480
# Home time zone, IANA name (e.g. America/New_York, Europe/London).
TIMEZONE=America/New_York
# Base URL for OAuth/webhook callbacks. Optional on Railway (RAILWAY_PUBLIC_DOMAIN is used).
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite exposes only VITE_-prefixed vars to the browser)
VITE_WS_URL=ws://localhost:8000/ws/events
